# Google OAuth. Set real credentials and an exact registered callback before enabling.
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173

# Google Workspace SMTP relay. Sender and SMTP AUTH account can differ.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SENDER=sender@gmail.com
SMTP_USERNAME=smtp@gmail.com
SMTP_PASSWORD=

# Moderator API bearer secret; replace before exposing the backend.
MODERATOR_API_TOKEN=
SESSION_SECRET=replace-with-at-least-32-random-characters
