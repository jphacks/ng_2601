# macOS/editor metadata
.DS_Store
**/.DS_Store

# Local Python environments, caches, and bytecode
.venv/
**/.venv/
.pytest_cache/
**/.pytest_cache/
__pycache__/
**/__pycache__/
*.py[cod]

# Local secrets and environment files
**/.env
**/.env.*
!**/.env.example

# CyclerHub-back generated build marker
/back/.cyclerhub-back-build-fingerprint

# Upstream BRouter checkout. setup.sh recovers this external dependency; keep
# it out of ordinary commits until a gitlink is explicitly recorded.
/back/submodule/brouter/

# Downloaded BRouter extension data; routing data is fetched locally
/back/brouter_extension/segments/

# Downloaded source snapshots and generated external datasets
/back/data/raw/
/back/data/normalized/
