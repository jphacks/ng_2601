# macOS/editor metadata
.DS_Store
**/.DS_Store

# Local Python environments, caches, and bytecode
.venv/
**/.venv/
.pytest_cache/
**/.pytest_cache/
__pycache__/
**/__pycache__/
*.py[cod]

# Local secrets and environment files
**/.env
