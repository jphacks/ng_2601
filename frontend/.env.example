# mock: use in-memory mock data (default) / http: call the real backend
VITE_API_MODE=mock
# Base URL of the backend (used when VITE_API_MODE=http)
VITE_API_BASE_URL=http://localhost:8080
# Google login needs the same origin: set VITE_API_BASE_URL= (empty) and proxy /v1 to the backend
API_PROXY_TARGET=http://localhost:8080
