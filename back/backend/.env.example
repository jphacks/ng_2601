# Google OAuth. Set real credentials and an exact registered callback before enabling.
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/v1/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173
# Maximum map-query bbox area in square WGS84 degrees.
MAX_MAP_BBOX_AREA_DEG2=25

# Gmail submission with SMTP AUTH and an app password. Use smtp-relay.gmail.com
# only when the Workspace administrator has configured the relay allowlist.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# auto uses STARTTLS on 587 and implicit TLS on 465; never use plaintext with SMTP AUTH.
SMTP_SECURITY=auto
# required authenticates with SMTP_USERNAME/PASSWORD. Use auto only when the
# Workspace relay is explicitly configured for source-IP authentication.
SMTP_AUTH_MODE=required
# Set this to the deployment host's public FQDN when the SMTP provider rejects
# the default local hostname in EHLO. Leave empty to use Python's host name.
SMTP_HELO_NAME=
SMTP_SENDER=sender@gmail.com
SMTP_USERNAME=smtp@gmail.com
SMTP_PASSWORD=
# Local-only relay test destination; never used as a real user's fallback address.
SMTP_TEST_RECEIVER=

# Moderator API bearer secret; replace before exposing the backend.
MODERATOR_API_TOKEN=
# Dedicated bearer token for the CoreS3 ingest endpoint; use a long random value.
DEVICE_INGEST_TOKEN=
SESSION_SECRET=replace-me-before-starting
